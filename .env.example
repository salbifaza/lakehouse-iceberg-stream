# Copy this file to .env before running `docker compose up`.

# ── Source Postgres (the CDC source) ────────────────────────────────────────
# Same e-commerce schema as stream-debezium-kafka / stream-cdc-peerdb so this
# project's ingestion path is directly comparable to the Kafka+Debezium one.
SOURCE_PG_USER=ecommerce
SOURCE_PG_PASSWORD=ecommerce
SOURCE_PG_DB=ecommerce

# ── SeaweedFS (S3-compatible object storage, replaces MinIO) ───────────────
SEAWEEDFS_ACCESS_KEY=seaweedadmin
SEAWEEDFS_SECRET_KEY=seaweedadmin123
LAKEHOUSE_BUCKET=lakehouse
FLUSS_BUCKET=fluss

# ── Polaris (Iceberg REST catalog metastore) ────────────────────────────────
POLARIS_DB=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=polaris
POLARIS_BOOTSTRAP_CREDENTIALS=POLARIS,root,secret

# Polaris principals (fluss_tiering, analyst) are created by
# polaris/bootstrap.sh at startup; Polaris auto-generates their real
# clientId/clientSecret, which bootstrap.sh writes to ./polaris/creds.env
# (gitignored, not this file) for fluss-coordinator/fluss-tablet and trino
# to read at container start. Nothing to configure here.
